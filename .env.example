# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env - it is in .gitignore.
#
# Production values are supplied as environment variables by the deployment
# platform, not by a file. This template exists so a new developer knows
# exactly which variables the system requires.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local
APP_BASE_URL=http://localhost:3000

# --- Database --------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/commerce
DATABASE_USERNAME=commerce
DATABASE_PASSWORD=localdev

# --- Redis -----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Authentication --------------------------------------------------------
# Generate with: openssl rand -base64 64
# Must differ per environment. A shared secret across environments means a
# staging token is valid in production.
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# --- Object storage --------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=product-images
STORAGE_ACCESS_KEY=localdev
STORAGE_SECRET_KEY=localdev123

# --- Email -----------------------------------------------------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=orders@example.lk

# --- SMS -------------------------------------------------------------------
SMS_PROVIDER=mock        # mock | textlk | smslenz
SMS_API_KEY=
SMS_SENDER_ID=

# --- Payment gateway -------------------------------------------------------
PAYHERE_MODE=sandbox     # sandbox | live
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Public URL the gateway posts payment notifications to. Use a tunnel
# (ngrok, cloudflared) locally - the gateway cannot reach localhost.
PAYHERE_NOTIFY_URL=

# --- POS integration -------------------------------------------------------
# mock until the vendor questionnaire is answered; then rest | database | file
POS_ADAPTER=mock
POS_BASE_URL=
POS_API_KEY=
POS_SYNC_PRODUCTS_CRON=0 */15 * * * *
POS_SYNC_STOCK_CRON=0 */2 * * * *

# --- Inventory safety ------------------------------------------------------
# Minutes a checkout holds stock before the reservation expires.
INVENTORY_RESERVATION_TTL_MINUTES=15
# Units withheld from online sale as a buffer against sync latency.
# Raise this if POS discovery returns Tier C or D.
INVENTORY_DEFAULT_SAFETY_BUFFER=1

# --- Observability ---------------------------------------------------------
SENTRY_DSN=
